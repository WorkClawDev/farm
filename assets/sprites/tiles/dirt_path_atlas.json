  "variant_rule": {
    "two_variants": "idx = posmod(x + y, 2)  (path_h/path_h_b, path_v/path_v_b, path_edge_X/path_edge_X_b)",
    "interior": "path_dirt_[a,b,c][posmod(x + 2*y, 3)]"
  },
  "refinement": {
    "all4 (mask 15)": {
      "diagonals checked": [
        "nw",
        "ne",
        "sw",
        "se"
      ],
      "0 missing": "interior (path_dirt_a/b/c)",
      "1 missing": "path_inner_<missing>",
      "2 missing": "interior (path_dirt_a/b/c) - no double-inner tile; one bite or cross both looked worse",
      "3-4 missing": "path_cross"
    },
    "three (mask 7,11,13,14)": {
      "rule": "if AT LEAST ONE of the two diagonals on the path side is path -> edge tile (variant by parity); if neither -> T tile. (T with one diagonal leaves a grass hole inside the dirt mass; checked visually)",
      "cases": {
        "14": {
          "diagonals": [
            "se",
            "sw"
          ],
          "edge": [
            "path_edge_n",
            "path_edge_n_b"
          ],
          "else": "path_t_s"
        },
        "13": {
          "diagonals": [
            "nw",
            "sw"
          ],
          "edge": [
            "path_edge_e",
            "path_edge_e_b"
          ],
          "else": "path_t_w"
        },
        "11": {
          "diagonals": [
            "ne",
            "nw"
          ],
          "edge": [
            "path_edge_s",
            "path_edge_s_b"
          ],
          "else": "path_t_n"
        },
        "7": {
          "diagonals": [
            "ne",
            "se"
          ],
          "edge": [
            "path_edge_w",
            "path_edge_w_b"
          ],
          "else": "path_t_e"
        }
      }
    },
    "two adjacent (mask 3,6,9,12)": {
      "rule": "if the diagonal between the two arms is path -> outer corner, else 1-wide bend",
      "cases": {
        "6": {
          "diagonal": "se",
          "outer": "path_outer_nw",
          "else": "path_bend_es"
        },
        "12": {
          "diagonal": "sw",
          "outer": "path_outer_ne",
          "else": "path_bend_sw"
        },
        "9": {
          "diagonal": "nw",
          "outer": "path_outer_se",
          "else": "path_bend_wn"
        },
        "3": {
          "diagonal": "ne",
          "outer": "path_outer_sw",
          "else": "path_bend_ne"
        }
      }
    },
    "others (0,1,2,4,8,5,10)": "mask4 only, diagonals ignored"
  },
  "isolated_fallback": "path_end_s (no 4-side-grass tile; only its south side is open (flat bottom), see DIRT_PATH.md)",
  "update_on_change": "re-pick the changed cell and its 8 neighbours",
